# Copy this file to .env.local and fill in real values there. .env.local is
# gitignored; this file is the only env file committed to the repo, and it
# must only ever contain placeholders, never a real key.

# Provider seam: "real" calls the actual vendor APIs below, "fake" uses the
# in-memory fakes and refuses to run when NODE_ENV=production. Leave as
# "real" for an actual deploy; tests set this to "fake" on their own.
VOICE_PROVIDERS=real

# --- Vendor API keys (placeholders only, never commit a real key) ---------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
DEEPGRAM_API_KEY=REPLACE_ME
ELEVENLABS_API_KEY=REPLACE_ME

# ElevenLabs voice ids per persona (see lib/personas/manifest.ts). A persona
# whose voice id env var is unset is treated as unusable everywhere, by
# design: fail closed on missing consent/voice configuration.
ELEVENLABS_NARSI_VOICE_ID=REPLACE_ME
ELEVENLABS_SAM_VOICE_ID=REPLACE_ME

# --- Model ids (issue 4: check these against current vendor docs) --------
LLM_MODEL=claude-sonnet-4-6
STT_MODEL=nova-2
TTS_MODEL=eleven_flash_v2_5
TTS_OUTPUT_FORMAT=mp3_44100_128
MAX_REPLY_TOKENS=256

# --- Abuse limits and budgets (issue 2) -----------------------------------
MAX_STT_BYTES=5242880
MAX_CHAT_MESSAGES=40
MAX_CHAT_CHARS=8000
MAX_SPOKEN_CHARS=2000
MAX_TURNS_PER_SESSION=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
DAILY_BUDGET_LLM_TOKENS=500000
DAILY_BUDGET_STT_SECONDS=7200
DAILY_BUDGET_TTS_CHARS=500000

# Secret used to sign /api/chat -> /api/tts reply tokens. Generate a real
# random value for any real deploy, for example: openssl rand -hex 32
TURN_SECRET=REPLACE_ME_WITH_A_RANDOM_SECRET
REPLY_TOKEN_TTL_MS=120000

# Issue 8: the access-gate cookie (proxy.ts) is signed with its own
# secret, never with the access code itself. Falls back to TURN_SECRET if
# unset; set a distinct value for a real deploy.
ACCESS_COOKIE_SECRET=REPLACE_ME_WITH_A_RANDOM_SECRET

# Issue 5: the session-identity cookie is signed separately so it can be
# rotated independently of the other two secrets. Falls back to
# TURN_SECRET if unset; set a distinct value for a real deploy.
SESSION_COOKIE_SECRET=REPLACE_ME_WITH_A_RANDOM_SECRET

# Shared-secret access gate (proxy.ts). Leave unset to disable the gate
# entirely, which is fine for local dev, not for a public deploy: with
# NODE_ENV=production and no ACCESS_CODE set, every request is denied
# rather than the gate silently opening for everyone.
ACCESS_CODE=REPLACE_ME

# Kill switch: set to false to immediately stop all voice traffic without
# a redeploy.
VOICE_ENABLED=true

# Issue 5: how long a per-session turn count is kept before it is swept,
# and the maximum number of distinct sessions tracked at once, so the
# in-memory map this relies on cannot grow without bound.
SESSION_TURNS_TTL_MS=86400000
MAX_SESSION_ENTRIES=50000

# Issue 6: a worst-case seconds reservation for one STT call, used only to
# make the daily STT-seconds budget check atomic (reserve before the
# call, settle to the real value after).
STT_RESERVATION_SECONDS=120

# Issue 16: minimum length (characters) a secret must be in production
# before it is accepted; also used to reject the placeholder values above
# if they are left unchanged.
MIN_SECRET_LENGTH=16

# --- Issue 3/4: crisis backstop -------------------------------------------
# A real, usable, international default: findahelpline.com (a directory of
# crisis lines by country) plus the US 988 Suicide and Crisis Lifeline as a
# concrete fallback. A deployer who knows their audience's country should
# set this to a localized line.
CRISIS_RESOURCES=If you are in immediate danger, please contact your local emergency number. You can find a crisis line for your country at findahelpline.com. In the US, you can call or text 988 (Suicide and Crisis Lifeline) anytime.
